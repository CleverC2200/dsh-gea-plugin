{
  "name": "@cleverc2200/dsh-page-interaction",
  "version": "0.1.0",
  "type": "module",
  "description": "Select page content, quote it in DSH and reuse declared page actions",
  "license": "Apache-2.0",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./page": "./lib/page.js",
    "./bridge": "./lib/bridge.js",
    "./package.json": "./package.json",
    "./picker": "./lib/picker.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
