{
  "name": "@cleverc2200/gea-dsh-prototype",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Independent GEA workbench and model adapter for the DeepSeek Harness fork",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs scripts/gea-error.test.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "verify": "node scripts/verify.mjs",
    "package": "node scripts/package.mjs",
    "test:package": "node --test scripts/package-smoke.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.1",
    "@deepseek-ai/dsh-persona": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "decimal.js": "10.6.0",
    "esbuild": "0.25.9",
    "eventsource-parser": "3.1.1",
    "qrcode": "1.5.4",
    "yaml": "2.9.0",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@arco-design/web-react": "2.66.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@icon-park/react": "1.4.2",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "i18next": "23.7.16",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "xlsx-republish": "0.20.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "files": [
    "lib/host.js",
    "lib/client.js",
    "lib/workbench.js",
    "lib/workbench.css",
    "presets/",
    "scripts/start.mjs",
    "scripts/deployment.mjs",
    "scripts/dsh-source.mjs",
    "scripts/verify.mjs",
    "src/environments.js",
    "src/workbench-original/LICENSE",
    "src/workbench-original/SOURCE.md",
    "src/workbench-original/source-manifest.json",
    "gea.direct.example.json",
    "gea.config.example.json",
    "README.md",
    "docs/install.md",
    "src/workbench-original/README.md",
    "npm-shrinkwrap.json"
  ]
}
