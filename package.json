{
  "name": "@cleverc2200/gea-dsh-prototype",
  "version": "0.0.127",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "type": "module",
  "description": "GEA business Agent plugin for the shared DeepSeek Harness workbench",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:build": "node --test scripts/build.test.mjs",
    "test:dependencies": "node --test scripts/dependency-lock.test.mjs",
    "observe": "node scripts/dev-observe.mjs",
    "observe:report": "node scripts/dev-observe-report.mjs",
    "test:observe": "node --test scripts/dev-observe.test.mjs",
    "test": "node --test tests/*.test.mjs scripts/gea-error.test.mjs",
    "test:desktop": "pnpm run test:desktop:unit",
    "test:desktop:unit": "node scripts/build-desktop-tools.mjs && node --test desktop/navigation.test.cjs desktop/packaging-config.test.cjs scripts/package-desktop.test.mjs desktop/config.test.cjs desktop/boot-watch.test.cjs desktop/onboarding.test.mjs desktop/permissions.test.mjs desktop/login-state.test.mjs desktop/company-resources.test.mjs desktop/html-plugins.test.mjs desktop/copy-graph.test.mjs desktop/graph-relocation.test.mjs desktop/plugin-store.test.mjs desktop/recovery.test.mjs desktop/updates.test.mjs desktop/client-installer.test.mjs desktop/installer-sdk-pruning.test.mjs desktop/installer-timing.test.cjs desktop/startup-copy.test.cjs desktop/verify-client-artifacts.test.cjs desktop/menu-localization.test.cjs desktop/runtime-cookies.test.cjs desktop/plugin-storage.test.mjs desktop/core-layer.test.mjs desktop/windows-directory-installer.test.cjs desktop/installer-cache.test.mjs desktop/installer-differential.test.mjs desktop/installer-signature.test.mjs",
    "test:desktop:electron": "node --test desktop/startup-state.test.mjs desktop/electron-recovery.test.mjs desktop/slow-login.test.mjs desktop/business-ready.test.mjs",
    "test:desktop:update-channel": "node desktop/update-speed-smoke.mjs",
    "build": "node scripts/build.mjs",
    "build:plugin": "node scripts/build.mjs --target host,client,workbench",
    "build:host": "node scripts/build.mjs --target host",
    "build:client": "node scripts/build.mjs --target client",
    "build:workbench": "node scripts/build.mjs --target workbench",
    "build:example": "node scripts/build.mjs --target example",
    "dev": "node scripts/build.mjs --target host,client,workbench --watch",
    "start": "node scripts/start.mjs",
    "verify": "node scripts/verify.mjs",
    "package": "node scripts/package.mjs",
    "test:package": "node --test scripts/package-smoke.test.mjs",
    "presets:sync": "node scripts/sync-default-preset.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "test:desktop:dev": "node --test scripts/desktop-dev.test.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:desktop:mac": "node scripts/package-desktop.mjs --target mac",
    "package:desktop:win": "node scripts/package-desktop.mjs --target win",
    "test:package:desktop": "node --test scripts/package-desktop.test.mjs"
  },
  "dependencies": {
    "@changfenhuang/dsh-genui": "0.11.1-preview.2",
    "@cleverc2200/dsh-agent-workbench": "git+http://100.100.6.191:20656/chenyonghao/dsh-agent-workbench.git#8558e64c0af6275a1f3289dd2d10a83203dfd03a",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.2",
    "@deepseek-ai/dsh-persona": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "decimal.js": "10.6.0",
    "dsh-better-sidebar": "0.19.1",
    "esbuild": "0.25.9",
    "eventsource-parser": "3.1.1",
    "qrcode": "1.5.4",
    "yaml": "2.9.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@cleverc2200/dsh-agent-workbench"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@arco-design/web-react": "2.66.1",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.2",
    "@electron/asar": "3.4.1",
    "@icon-park/react": "1.4.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.9",
    "i18next": "23.7.16",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "xlsx-republish": "0.20.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "files": [
    "lib/host.js",
    "lib/skill-reference.js",
    "lib/client.js",
    "lib/workbench.js",
    "lib/workbench.css",
    "presets/",
    "default-presets/",
    "scripts/start.mjs",
    "scripts/deployment.mjs",
    "scripts/verify.mjs",
    "src/shared/environments.js",
    "src/workbench/original/LICENSE",
    "src/workbench/original/SOURCE.md",
    "src/workbench/original/source-manifest.json",
    "gea.direct.example.json",
    "gea.config.example.json",
    "README.md",
    "docs/install.md",
    "src/workbench/original/README.md",
    "npm-shrinkwrap.json",
    "packages/workbench-example/package.json",
    "packages/workbench-example/lib/host.js",
    "packages/workbench-example/lib/client.js",
    "packages/workbench-example/README.md",
    "cordis.patch.yml",
    "presets/inventory-aqkc.skill.md",
    "presets/inventory-dealer.skill.md",
    "presets/prompt-policy.json",
    "presets/inventory-apsplan.skill.md",
    "presets/inventory-fc.skill.md",
    "presets/inventory-qll.skill.md"
  ],
  "workspaces": [
    "packages/*"
  ]
}
