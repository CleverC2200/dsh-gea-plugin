{
  "schemaVersion": 1,
  "required": [
    "scripts/run-quality-checks.test.mjs",
    "scripts/quality.test.mjs",
    "scripts/quality-policy.test.mjs",
    "scripts/run-quality-ci.test.mjs",
    "scripts/quality-upstreams.test.mjs",
    "scripts/quality-test-reporter.test.mjs",
    "scripts/quality-workbench.test.mjs",
    "scripts/run-quality-full.test.mjs",
    "tests/controlled-execution.test.mjs",
    "tests/plugin-sql-cancel.test.mjs",
    "tests/business-page-grant.test.mjs",
    "tests/gateway-handshake.test.mjs",
    "tests/window-launch-admission.test.mjs",
    "tests/source-selection-start.test.mjs",
    "tests/source-integrity.test.mjs",
    "scripts/delivery-check.test.mjs",
    "scripts/delivery-integrity.test.mjs",
    "scripts/delivery-readiness.test.mjs",
    "scripts/delivery-runtime.test.mjs",
    "scripts/delivery-continuation.test.mjs"
  ],
  "tests": ["tests/*.test.mjs", "scripts/*.test.mjs"],
  "rules": [
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^(?:package\\.json|pnpm-lock\\.yaml|tsconfig|\\.github/|scripts/ci-test-policy\\.json)",
      "tests": ["scripts/run-quality-ci.test.mjs", "tests/window-launch-admission.test.mjs"],
      "exclusive": true
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^(?:presets|default-presets|business-skills)/",
      "tests": ["tests/prompt-execution-state.test.mjs", "tests/capability-recipes.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^src/(?:client|company|frame|page|workbench|business)",
      "tests": ["tests/controlled-execution.test.mjs", "tests/business-page-grant.test.mjs"]
    },
    {
      "repo": "dsh-agent-manage",
      "pattern": "^(?:src|business-resources|presets)/",
      "tests": ["tests/controlled-execution.test.mjs", "tests/business-page-grant.test.mjs"]
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^desktop/",
      "tests": ["tests/window-launch-admission.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/",
      "tests": ["scripts/run-quality-ci.test.mjs", "tests/window-launch-admission.test.mjs"],
      "exclusive": true
    },
    {
      "repo": "dsh-agent-manage",
      "pattern": "^scripts/",
      "tests": ["scripts/run-quality-ci.test.mjs", "tests/window-launch-admission.test.mjs"],
      "exclusive": true
    }
  ]
}
