{
  "schemaVersion": 1,
  "required": [
    "scripts/run-quality-checks.test.mjs",
    "scripts/quality.test.mjs",
    "scripts/quality-policy.test.mjs",
    "scripts/run-quality-ci.test.mjs",
    "scripts/run-quality-ci-stages.test.mjs",
    "scripts/quality-upstreams.test.mjs",
    "scripts/quality-test-reporter.test.mjs",
    "scripts/quality-workbench.test.mjs",
    "scripts/run-quality-full.test.mjs",
    "tests/controlled-execution.test.mjs",
    "tests/plugin-sql-cancel.test.mjs",
    "tests/business-page-grant.test.mjs",
    "tests/gateway-handshake.test.mjs",
    "tests/window-launch-admission.test.mjs",
    "tests/source-selection-start.test.mjs",
    "tests/source-integrity.test.mjs",
    "scripts/delivery-check.test.mjs",
    "scripts/delivery-integrity.test.mjs",
    "scripts/delivery-readiness.test.mjs",
    "scripts/delivery-runtime.test.mjs",
    "scripts/delivery-continuation.test.mjs"
  ],
  "tests": [
    "tests/*.test.mjs",
    "scripts/*.test.mjs",
    "tests/*.contract.mjs",
    "tests/*.browser.mjs"
  ],
  "rules": [
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^src/host/(?:cube-gap-ledger|mcp-read-evidence)\\.ts$",
      "tests": [
        "tests/current-mcp-tools.test.mjs",
        "tests/cube-direct-mcp.test.mjs",
        "tests/prompt-execution-state.test.mjs"
      ]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^business/inventory-(?:aqkc|dealer|fc|personal|qll)/source/",
      "tests": ["tests/source-integrity.test.mjs", "tests/branch-stock-ability-web.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^static/regional/source/index\\.html$",
      "tests": ["tests/page-interaction-workbenches.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^(?:business|static|theme)/",
      "tests": ["scripts/quality-workbench.test.mjs", "tests/business-page-grant.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^src/sales-plan\\.ts$",
      "tests": ["tests/sales-plan-action.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/ci-source-policy\\.mjs$",
      "tests": ["scripts/business-profile-ci.test.mjs"]
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^src/(?:host\\.ts|host/(?:api-log|business|debug-run))",
      "tests": [
        "tests/api-log.test.mjs",
        "tests/api-log-replay.test.mjs",
        "tests/api-log-web.test.mjs"
      ]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^src/(?:workbench/api-log|business-views|workbench/page)",
      "tests": [
        "tests/api-log.test.mjs",
        "tests/api-log-replay.test.mjs",
        "tests/api-log-web.test.mjs"
      ]
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^(?:package\\.json|pnpm-lock\\.yaml|tsconfig|\\.github/|scripts/ci-test-policy\\.json)",
      "tests": ["scripts/run-quality-ci.test.mjs", "tests/window-launch-admission.test.mjs"],
      "exclusive": true
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^scripts/ci-test-policy\\.json$",
      "tests": ["scripts/ci-policy-impact.test.mjs", "tests/sales-plan-action.test.mjs"]
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^scripts/final-group-input\\.contract\\.mjs$",
      "tests": ["scripts/run-quality-ci.test.mjs", "scripts/run-quality-ci-stages.test.mjs"]
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^src/(?:client\\.tsx|host/plugin-update|plugin-updates|plugin-detail-updates|plugin-update-locales|shared/plugin-update|host/plugin-release|shared/plugin-release)",
      "tests": [
        "tests/plugin-update-controller.contract.mjs",
        "tests/plugin-update-integration.contract.mjs",
        "tests/plugin-release-source.test.mjs",
        "tests/plugin-release.test.mjs",
        "tests/plugin-update-install.contract.mjs",
        "tests/plugin-update-detail.browser.mjs"
      ]
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^(?:presets|default-presets|business-skills)/",
      "tests": ["tests/prompt-execution-state.test.mjs", "tests/capability-recipes.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^src/(?:client|company|frame|page|workbench|business)",
      "tests": ["tests/controlled-execution.test.mjs", "tests/business-page-grant.test.mjs"]
    },
    {
      "repo": "dsh-agent-manage",
      "pattern": "^(?:src|business-resources|presets)/",
      "tests": ["tests/controlled-execution.test.mjs", "tests/business-page-grant.test.mjs"]
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^desktop/",
      "tests": ["tests/window-launch-admission.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/",
      "tests": ["scripts/run-quality-ci.test.mjs", "tests/window-launch-admission.test.mjs"],
      "exclusive": true
    },
    {
      "repo": "dsh-agent-manage",
      "pattern": "^scripts/",
      "tests": ["scripts/run-quality-ci.test.mjs", "tests/window-launch-admission.test.mjs"],
      "exclusive": true
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^scripts/plugin-update-pr-lane\\.",
      "tests": ["scripts/run-quality-ci.test.mjs"],
      "exclusive": true
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^(?:scripts/(?:check-plugin-updates-types|create-plugin-release|build)\\.mjs|tests/(?:acceptance/plugin-update-desktop\\.mjs|fixtures/plugin-updates/installed-runtime\\.mjs))$",
      "tests": [
        "scripts/build.test.mjs",
        "tests/plugin-update-install.contract.mjs",
        "tests/plugin-update-detail.browser.mjs",
        "tests/plugin-release-source.test.mjs"
      ]
    }
  ]
}
